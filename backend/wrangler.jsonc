{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitter-disk-3576weather-edge-worker",
  "main": "worker.single.js",
  "compatibility_date": "2026-10-07",
  "vars": {
    "ALLOWED_ORIGINS": "https://aipredictionengines.github.io,http://localhost:8787,http://127.0.0.1:5500",
    "ALLOW_PUBLIC_COLLECTORS": "false",
    "X_QUERY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airdrop-radar",
      "database_id": "fb709e62-31ae-4a4f-8c7d-5dca74dbd158"
    }
  ],
  "triggers": {
    "crons": [
      "15 */6 * * *",
      "45 * * * *"
    ]
  }
}
